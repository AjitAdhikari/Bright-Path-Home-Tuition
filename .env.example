# ── Supabase ─────────────────────────────────────────────
# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=9779800000000

# ── Payments (server-only) ───────────────────────────────
# eSewa ePay v2
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Khalti
KHALTI_SECRET_KEY=your-khalti-secret-key

# ── SMS / WhatsApp provider (server-only) ────────────────
SMS_PROVIDER_API_KEY=your-sms-key

# ── Email (Resend, server-only) ──────────────────────────
# Leave RESEND_API_KEY blank to disable email (sends become no-ops, still
# logged to email_notifications). Set it + a verified sender to go live.
RESEND_API_KEY=
EMAIL_FROM=Bright Path <onboarding@resend.dev>
